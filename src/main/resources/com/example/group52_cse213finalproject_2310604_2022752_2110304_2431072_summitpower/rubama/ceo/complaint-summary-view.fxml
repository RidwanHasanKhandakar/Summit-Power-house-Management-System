<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="811.0" prefWidth="1211.0" style="-fx-background-color: #193154;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group52_cse213finalproject_2310604_2022752_2110304_2431072_summitpower.rubama.ceo.controller.ComplaintSummaryViewController">

   <children>

      <!-- Page Title -->
      <Label layoutX="421.0" layoutY="43.0" prefHeight="64.0" prefWidth="365.0" text="Complaint Summary" textFill="#f5f2f2" underline="true">

         <font>
            <Font name="Times New Roman" size="43.0" />
         </font>

      </Label>


      <!-- Status -->
      <Label layoutX="297.0" layoutY="177.0" text="Status:" textFill="WHITE">

         <font>
            <Font name="System Bold" size="14.0" />
         </font>

      </Label>

      <ComboBox fx:id="statusComboBox" layoutX="404.0" layoutY="172.0" prefHeight="31.0" prefWidth="187.0" />


      <!-- Complaint Date -->
      <Label layoutX="644.0" layoutY="177.0" text="Complaint Date:" textFill="#fffefe">

         <font>
            <Font name="System Bold" size="14.0" />
         </font>

      </Label>

      <DatePicker fx:id="dateOfComplaintDatePicker" layoutX="773.0" layoutY="172.0" prefHeight="31.0" prefWidth="176.0" />


      <!-- View Complaints -->
      <Button layoutX="404.0" layoutY="268.0" mnemonicParsing="false" onAction="#handleViewComplaints" prefHeight="49.0" prefWidth="414.0" style="-fx-background-color: #49b0ff;" text="View Complaints">

         <font>
            <Font name="System Bold" size="15.0" />
         </font>

      </Button>


      <!-- Complaint Table -->
      <TableView fx:id="complaintTableView" layoutX="58.0" layoutY="361.0" prefHeight="243.0" prefWidth="1147.0">

         <columns>

            <TableColumn fx:id="complaintIdCol" prefWidth="205.0" text="Complaint ID" />

            <TableColumn fx:id="dateOfComplaintCol" prefWidth="324.0" text="Date of Complaint" />

            <TableColumn fx:id="statusCol" prefWidth="292.0" text="Status" />

            <TableColumn fx:id="categoryCol" prefWidth="324.0" text="Category" />

         </columns>

      </TableView>


      <!-- Generate Summary -->
      <Button layoutX="354.0" layoutY="632.0" mnemonicParsing="false" onAction="#handleComplaintSummary" prefHeight="49.0" prefWidth="556.0" style="-fx-background-color: #49b0ff;" text="Complaint Summary">

         <font>
            <Font name="System Bold" size="15.0" />
         </font>

      </Button>


      <!-- Summary Output -->
      <Label fx:id="viewComplaintSummaryLabel" layoutX="356.0" layoutY="686.0" prefHeight="105.0" prefWidth="564.0" text="Complaint Summary" textFill="WHITE" wrapText="true">

         <font>
            <Font name="System" size="15.0" />
         </font>

      </Label>


      <!-- Return -->
      <Button layoutX="1018.0" layoutY="35.0" mnemonicParsing="false" onAction="#handleReturn" prefHeight="49.0" prefWidth="176.0" style="-fx-background-color: #49b0ff;" text="Return">

         <font>
            <Font name="System Bold" size="15.0" />
         </font>

      </Button>


      <!-- Footer -->
      <Label alignment="CENTER" contentDisplay="CENTER" layoutY="812.0" prefHeight="31.0" prefWidth="1243.0" style="-fx-background-color: #49b0ff;" text="© Mission 9232 LTD." />

